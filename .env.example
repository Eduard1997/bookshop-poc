# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it with real secrets.

# --- Payload / Postgres (local, via compose.yaml) ---
DATABASE_URI=postgres://postgres:postgres@localhost:5432/bookshop
PAYLOAD_SECRET=change-me-to-a-random-string

# --- Emporix tenant ---
# Ask your mentor for these. Do not share them outside the team.
EMPORIX_TENANT_ID=
EMPORIX_CLIENT_ID=
EMPORIX_CLIENT_SECRET=
EMPORIX_API_BASE_URL=https://api.emporix.io
